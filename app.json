{
  "expo": {
    "name": "Steel Ark XYZ",
    "slug": "super-robot-wars-xyz",
    "version": "20.4.0",
    "orientation": "landscape",
    "icon": "./assets/art/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05070f",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.fareza777.srwxyz",
      "adaptiveIcon": {
        "backgroundColor": "#0a0f1e",
        "foregroundImage": "./assets/art/icon_fg2.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/art/splash.jpg",
          "resizeMode": "cover",
          "backgroundColor": "#05070f"
        }
      ]
    ]
  }
}